# --- PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
# Leave empty to run in clearly-labelled simulation mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox *personal* accounts (developer.paypal.com -> Sandbox -> Accounts) that receive payouts
PAYPAL_KARIGAR_EMAIL=
PAYPAL_SAATHI_EMAIL=
# Sandbox buyer account used on invoices until the real payer email is known
PAYPAL_CUSTOMER_EMAIL=
# Optional: a sandbox *buyer* login shown under the PayPal button so judges can test payments
# (Testing Tools > Sandbox Accounts > a Personal account). Test money only; never real credentials.
PAYPAL_DEMO_BUYER_EMAIL=
PAYPAL_DEMO_BUYER_PASSWORD=
# Optional: webhook id from your sandbox app's Webhooks section (enables signature verification).
# Subscribe the webhook to payment events and, for Sudhaar Care, BILLING.SUBSCRIPTION.* and PAYMENT.SALE.COMPLETED.
PAYPAL_WEBHOOK_ID=
# Optional: this site's public address, used as the PayPal return link for Sudhaar Care
# (e.g. https://sudhaar-mm59.onrender.com). Without it the address is taken from the request.
# APP_URL=

# --- AI (Google Gemini) ---
# Free key: aistudio.google.com -> Get API key. Leave empty to use the simulated estimator.
# The Repair Agent (Talk tab) requires a key.
GEMINI_API_KEY=
# Optional: a specific Gemini model; defaults to Google's current Flash model.
# AI_MODEL=gemini-flash-latest

# --- Phone line on Bolna (docs/BOLNA.md) ---
# Secret Bolna sends to Sudhaar's /api/voice/* endpoints. Leave empty to keep the phone line off.
VOICE_API_TOKEN=
# Optional: the number customers dial (shown on the website)
VOICE_PHONE_NUMBER=
# Optional: "Ask Sudhaar to call me" (Bolna outbound call API)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# BOLNA_FROM_NUMBER=

# --- Logins ---
# Secret that signs login cookies (any long random string). If empty, one is generated
# and saved in DATA_DIR/.session-secret.
SESSION_SECRET=

# --- Demo ---
# DEMO_CENTER_LAT=12.9716
# DEMO_CENTER_LNG=77.5946
# DATA_DIR=./data
