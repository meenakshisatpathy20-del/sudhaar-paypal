# --- PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
# Leave empty to run in clearly-labelled simulation mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox *personal* accounts (developer.paypal.com -> Sandbox -> Accounts) that receive payouts
PAYPAL_KARIGAR_EMAIL=
PAYPAL_SAATHI_EMAIL=
# Sandbox buyer account used on invoices until the real payer email is known
PAYPAL_CUSTOMER_EMAIL=
# Optional: webhook id from your sandbox app's Webhooks section (enables signature verification)
PAYPAL_WEBHOOK_ID=

# --- AI (Claude) ---
# Leave empty to use the simulated estimator. The Repair Agent requires a key.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Logins ---
# Secret that signs login cookies (any long random string). If empty, one is generated
# and saved in DATA_DIR/.session-secret.
SESSION_SECRET=

# --- Demo ---
# DEMO_CENTER_LAT=12.9716
# DEMO_CENTER_LNG=77.5946
# DATA_DIR=./data
